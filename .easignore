# Native directories — excluded so EAS runs prebuild,
# which applies all config plugins (setAlarmClock, direct
# presentation, notification reschedule, widgets, etc.)
# Leading / ensures only top-level dirs are excluded
/android/
//android/
/android/**
/ios/
/ios/**
/functions/
credentials/
.git/
*.tgz
# Exclude all of tmp/ EXCEPT the widget-previews build input, which
# generate-android-widget-preview-images.mjs reads during prebuild
# (anchors.json + baked snapshot PNGs). Excluding it makes prebuild
# fail with "No pulled anchors for prayerSingle_small".
/tmp/*
# No trailing slash: EAS copies the working dir via fs.cp with a directory
# filter, so the directory itself must be re-included or cp never descends
# into it (the trailing-slash form skips the whole subtree).
!/tmp/widget-previews
!/tmp/widget-previews/**
# Local native build caches
android/app/build/
android/.cxx/
ios/build/
ios/Pods/
build/ios/
