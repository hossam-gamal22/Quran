# Copy this file to .env and fill values locally.
# Never commit real tokens or API keys.

# Pexels API key used for story background images.
# EXPO_PUBLIC_ values are bundled into the app, so prefer a backend proxy
# for production if quota abuse matters.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY_ANDROID=
EXPO_PUBLIC_FIREBASE_API_KEY_IOS=
EXPO_PUBLIC_FIREBASE_API_KEY_WEB=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_APP_ID_ANDROID=
EXPO_PUBLIC_FIREBASE_APP_ID_IOS=
EXPO_PUBLIC_FIREBASE_APP_ID_WEB=

EXPO_PUBLIC_PEXELS_API_KEY=
VITE_PEXELS_API_KEY=

# Story renderer server URL.
EXPO_PUBLIC_STORY_RENDERER_URL=

# Sunnah.com API key.
EXPO_PUBLIC_SUNNAH_API_KEY=

# EmailJS public browser-side configuration.
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=

# Server-side Expo token. This must only live in local env / Firebase secrets /
# CI secrets, never in client code or Git.
EXPO_ACCESS_TOKEN=
