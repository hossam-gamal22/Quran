# admin-panel/.env.example
VITE_API_URL=https://api.roohmuslim.com
VITE_APP_NAME=Admin Panel
VITE_APP_DESCRIPTION=Admin panel for managing the application
VITE_APP_KEYWORDS=admin, panel, management, dashboard

# Local/Netlify admin auth and serverless functions
# Generate the hash with:
#   node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('YOUR_PASSWORD')).then(b=>console.log([...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('')))"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=24
ADMIN_PANEL_ORIGINS=http://localhost:8888,http://127.0.0.1:8888
EXPO_ACCESS_TOKEN=

# Used by `pnpm run dev:netlify`; do not prefix secrets with VITE_.
VITE_USE_NETLIFY_API=true
VITE_NETLIFY_FUNCTIONS_DIRECT=false

# ─── Islamic events auto-notify cron ────────────────────────────────
# Firebase Admin SDK service account credentials (server-side only).
# Get them from Firebase Console → Project Settings → Service Accounts → Generate new private key.
# Either set the three pieces individually:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# IMPORTANT: paste the private key with literal "\n" line breaks (as it appears in the JSON)
FIREBASE_PRIVATE_KEY=
# Or alternatively paste the entire service-account JSON (raw or base64) — overrides the three above:
FIREBASE_SERVICE_ACCOUNT_JSON=
