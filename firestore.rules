rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Admin Authentication (HARDENED) ─────────────────────────
    // Password hash + active session token live here.
    // Reading/writing this document is FORBIDDEN from clients.
    // The admin panel verifies passwords ONLY via the Netlify
    // function `verify-admin`, which uses a server-side env var hash.
    // NOTE: Firestore rules use OR-combination, so the wildcard rule
    // below MUST also explicitly exclude `adminAuth`.
    match /appConfig/adminAuth {
      allow read, write: if false;
    }

    // Website pages - public read/write for admin panel + dynamic pages
    match /websitePages/{pageId} {
      allow read, write: if true;
    }

    // App config - public read, authenticated write
    // Mobile app reads sound settings, notification defaults, etc.
    // Admin panel writes assignments and config (requires login)
    // EXPLICITLY excludes `adminAuth` (rules combine via OR).
    match /appConfig/{docId} {
      allow read: if docId != 'adminAuth';
      allow write: if docId != 'adminAuth';
    }

    // Config collection - app settings, subscriptions, feature gating, rewards, ads
    match /config/{docId} {
      allow read, write: if true;
    }

    // Temp pages - public read/write for dynamic pages
    match /tempPages/{pageId} {
      allow read, write: if true;
    }

    // Stats - public read/write for analytics
    match /stats/{docId} {
      allow read, write: if true;
    }

    // Activity - public write for usage tracking
    match /activity/{docId} {
      allow read, write: if true;
    }

    // Users - public read/write for device-based registration
    match /users/{userId} {
      allow read, write: if true;
    }

    // Phase 2: FCM Prayer Push Fallback
    // الـ app يكتب موقع وإعدادات الصلاة، Cloud Function تقرأ
    match /userPrayerSettings/{userId} {
      allow read, write: if true;
    }
    // dedupe records — Cloud Function only
    match /fcmPrayerSent/{docId} {
      allow read, write: if false;
    }

    // Notifications - history and tracking from admin panel
    match /notifications/{docId} {
      allow read, write: if true;
    }

    // Radio stations - public read, admin write
    match /admin_radio_stations/{stationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Sound System ────────────────────────────────────────────
    // Custom uploaded sounds (library) — admin uploads, app reads URLs
    match /sounds/{soundId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Pending uploaded sounds for next build — admin only
    match /uploadedSounds/{soundId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Seasonal Content ────────────────────────────────────────
    // Seasonal banners, Ramadan/Hajj content — admin writes, app reads
    match /seasonalContent/{contentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Calendar & Events ───────────────────────────────────────
    // Islamic events (Eid, Ramadan start, etc.)
    match /islamicEvents/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Hijri date overrides/corrections
    match /hijri_overrides/{overrideId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Admin Content Collections ───────────────────────────────
    // PDF templates - admin managed
    match /pdfTemplates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // PDF uploads
    match /pdfUploads/{uploadId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Theme PDFs config
    match /themePdfs/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Daily Dhikr - admin managed content
    match /dailyDhikr/{dhikrId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tasbih presets - admin managed
    match /tasbihPresets/{presetId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── User Cloud Backups ─────────────────────────────────
    // Per-user backup metadata, keyed by OAuth openId.
    // Users can only read/write their own backup document.
    match /userBackups/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Suggestions — anyone can create, anyone can read (admin panel uses custom auth)
    match /suggestions/{docId} {
      allow read, create: if true;
      allow delete: if true;
    }

    // ─── Photo Backgrounds ──────────────────────────────────────
    // Photo backgrounds for app wallpapers — admin writes, app reads
    match /photoBackgrounds/{photoId} {
      allow read: if true;
      allow write: if true;
    }

    // Photo background categories config
    match /photoBackgroundCategories/{catId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── Purchase History ────────────────────────────────────────
    // User purchases subcollection — app writes, admin reads
    match /users/{userId}/purchases/{purchaseId} {
      allow read, write: if true;
    }

    // Q&A Content (read by app, managed by admin SDK)
    match /qaContent/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // User-submitted questions (app creates, admin reads/updates)
    match /userQuestions/{docId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
