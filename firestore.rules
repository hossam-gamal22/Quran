rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function adminWrite() {
      return isAdmin();
    }

    function boundedDoc(maxKeys) {
      return request.resource != null && request.resource.data.size() <= maxKeys;
    }

    function noUserPrivilegeEscalation() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'adminPremium',
        'role',
        'disabled',
        'hiddenFromLeaderboard',
        'isPremium',
        'iapPremium'
      ]);
    }

    function safeUserCreate() {
      // TEMPORARY (2026-06-06): `signedIn()` dropped because the published app
      // is not establishing a Firebase Auth session at write time, so every
      // user-doc write was being denied and monthly engagement stopped rolling
      // over. Privilege-escalation + score-monotonicity guards stay in force.
      // Re-add `signedIn()` once the auth fix ships in the app build.
      return boundedDoc(80)
        && !request.resource.data.keys().hasAny([
          'adminPremium',
          'role',
          'disabled',
          'hiddenFromLeaderboard',
          'iapPremium'
        ])
        && (
          !request.resource.data.keys().hasAny(['isPremium'])
          || request.resource.data.isPremium == false
        );
    }

    // Server-side defense-in-depth: prevent the monthly score from being
    // overwritten with a smaller value within the same month. The app uses
    // firestoreIncrement(...) for same-month bumps and Math.max(local, cloud)
    // for recalcs, so legitimate writes never need to decrease.
    function monthlyEngagementHasScore(data) {
      return data.keys().hasAny(['monthlyEngagement'])
        && data.monthlyEngagement is map
        && data.monthlyEngagement.keys().hasAny(['score'])
        && data.monthlyEngagement.score is number;
    }

    function sameMonthlyEngagementMonth() {
      return resource.data.monthlyEngagement.keys().hasAny(['month'])
        && request.resource.data.monthlyEngagement.keys().hasAny(['month'])
        && resource.data.monthlyEngagement.month == request.resource.data.monthlyEngagement.month;
    }

    function noMonthlyScoreDecrease() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['monthlyEngagement'])
        || !monthlyEngagementHasScore(resource.data)
        || (
          monthlyEngagementHasScore(request.resource.data)
          && (
            !sameMonthlyEngagementMonth()
            || request.resource.data.monthlyEngagement.score >= resource.data.monthlyEngagement.score
          )
        );
    }

    function safeUserUpdate() {
      // TEMPORARY (2026-06-06): `signedIn()` dropped — see safeUserCreate note.
      // Restores the pre-2026-05-26 ability for the published app to write its
      // own user doc (monthly engagement) without a guaranteed auth session.
      // Re-add `signedIn()` once the auth fix ships in the app build.
      return boundedDoc(100)
        && noUserPrivilegeEscalation()
        && noMonthlyScoreDecrease();
    }

    // User self-delete: allow if the doc's stored authUid matches the
    // currently-signed-in Firebase Auth uid, or if the legacy doc has no
    // authUid yet (older installs).
    function userOwnsDoc() {
      return signedIn() && (
        !resource.data.keys().hasAny(['authUid'])
        || resource.data.authUid == request.auth.uid
      );
    }

    // Notification open-tracking write from the client. Only `openedCount`,
    // `openedAt`, and `updatedAt` may be touched — nothing else.
    function notificationOpenWriteOnly() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'openedCount', 'openedAt', 'updatedAt'
        ]);
    }

    function safeQuestionPayload() {
      return request.resource.data.keys().hasOnly([
          'userName',
          'userEmail',
          'question',
          'status',
          'createdAt',
          'userId',
          'registeredName',
          'platform',
          'language',
          'requestMode',
          'fcmToken'
        ])
        && request.resource.data.question is string
        && request.resource.data.question.size() <= 4000
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail.size() <= 320
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 120;
    }

    function safeQuestionCreate() {
      return signedIn() && safeQuestionPayload();
    }

    function safeSuggestionCreate() {
      return signedIn()
        && boundedDoc(20);
    }

    function safeUserPrayerSettings() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'latitude', 'longitude', 'city', 'timezone',
          'timezoneOffsetMinutes', 'calculationMethod', 'madhab',
          'asrJuristic', 'adjustments',
          'fajrAdjust', 'sunriseAdjust', 'dhuhrAdjust',
          'asrAdjust', 'maghribAdjust', 'ishaAdjust',
          'enabled', 'disabled', 'notifyFajr', 'notifySunrise', 'notifyDhuhr',
          'notifyAsr', 'notifyMaghrib', 'notifyIsha',
          'soundFajr', 'soundDhuhr', 'soundAsr', 'soundMaghrib', 'soundIsha',
          'fcmToken', 'language', 'country', 'updatedAt', 'localNotificationsActiveAt',
          'localScheduleDays', 'localScheduleExpiresAt', 'refreshReminderAt',
          'nextPrayerAt', 'nextPrayerKey', 'fallbackEnabled',
          'fallbackSchemaVersion', 'fallbackUpdatedAt',
          'adhanSound', 'adhanSoundType', 'fullAdhanSoundType', 'useFullAdhan',
          'lastSyncedAt', 'platform', 'appVersion', 'deviceId'
        ])
        && request.resource.data.size() <= 32;
    }

    function safeCommentCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'displayName', 'text', 'createdAt', 'hidden', 'reportCount'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;
    }

    // Admin auth material is server-only.
    match /appConfig/adminAuth {
      allow read, write: if false;
    }

    // Public read, admin/server write content.
    match /websitePages/{pageId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /appConfig/{docId} {
      allow read: if docId != 'adminAuth';
      allow write: if docId != 'adminAuth' && adminWrite();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /cache/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /tempPages/{pageId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /stats/{docId} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && boundedDoc(40);
      allow delete: if adminWrite();
    }

    match /activity/{docId} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && boundedDoc(40);
      allow delete: if adminWrite();
    }

    match /activityDaily/{docId} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && boundedDoc(40);
      allow delete: if adminWrite();
    }

    // Legacy mobile builds read the leaderboard directly from `users` before
    // Firebase Auth is guaranteed to be ready. Keep reads public until the app
    // moves to a sanitized public leaderboard collection; writes stay locked.
    match /users/{userId} {
      allow read: if true;
      allow create: if safeUserCreate() || adminWrite();
      allow update: if safeUserUpdate() || adminWrite();
      allow delete: if userOwnsDoc() || adminWrite();
    }

    match /users/{userId}/premiumBackups/{backupId} {
      allow read, create, update: if signedIn() || adminWrite();
      allow delete: if adminWrite();
    }

    match /userPrayerSettings/{userId} {
      allow read: if isAdmin();
      allow create, update: if safeUserPrayerSettings() || adminWrite();
      allow delete: if adminWrite();
    }

    match /fcmPrayerSent/{docId} {
      allow read, write: if false;
    }

    match /notificationTelemetry/{userId} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.resource.data.size() <= 50;
      allow delete: if adminWrite();
    }

    match /notifications/{docId} {
      allow read: if signedIn() || isAdmin();
      // Admin writes everything; clients may only bump open-tracking fields
      // on existing notification docs (no create, no delete).
      allow create, delete: if adminWrite();
      allow update: if adminWrite() || notificationOpenWriteOnly();
    }

    match /admin_radio_stations/{stationId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /sounds/{soundId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /uploadedSounds/{soundId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /seasonalContent/{contentId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /islamicEvents/{eventId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /eventNotificationRuns/{runId} {
      allow read: if isAdmin();
      allow write: if adminWrite();
    }

    match /eventNotificationLog/{logId} {
      allow read: if isAdmin();
      allow write: if adminWrite();
    }

    match /hijri_overrides/{overrideId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    // Per-country Hijri source mode (admin override vs AlAdhan API).
    // Public read (the app resolves the date from it); admin-only write.
    match /hijri_overrides_config/{docId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /pdfTemplates/{templateId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /pdfUploads/{uploadId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /themePdfs/{docId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /appContent/{docId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /dailyContent/{docId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /backgrounds/{backgroundId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /translationOverrides/{overrideId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /translations/{lang} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /sdui_screens/{screenId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /dailyDhikr/{dhikrId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /dailyWisdomStories/{storyId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /splashScreens/{screenId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /tasbihPresets/{presetId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /azkar/{zikrId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /azkar_categories/{categoryId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /duas/{duaId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /selectedDuas/{duaId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /userBackups/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || resource.data.openId == userId
      );
      allow create, update: if signedIn()
        && request.resource.data.openId == userId
        && request.resource.data.size() <= 12;
      allow delete: if signedIn() && (
        request.auth.uid == userId
        || resource.data.openId == userId
      );
    }

    match /suggestions/{docId} {
      allow create: if safeSuggestionCreate();
      allow read, update, delete: if isAdmin();
    }

    match /photoBackgrounds/{photoId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /photoBackgroundCategories/{catId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /{path=**}/purchases/{purchaseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId}/purchases/{purchaseId} {
      allow read: if signedIn() || isAdmin();
      allow create: if signedIn() && boundedDoc(40);
      allow update, delete: if adminWrite();
    }

    match /qaContent/{docId} {
      allow read: if true;
      allow write: if adminWrite();
    }

    match /userQuestions/{docId} {
      // App listens to the single created question doc for the answer. Do not
      // allow public list queries, which would expose all user questions.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if safeQuestionCreate() || safeQuestionPayload();
      allow update, delete: if isAdmin();
    }

    match /storyInteractions/{storyId} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.size() <= 12;
      allow delete: if adminWrite();
    }

    match /storyInteractions/{storyId}/likes/{userId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.size() <= 5;
      allow delete: if signedIn() || adminWrite();
      allow update: if false;
    }

    match /storyInteractions/{storyId}/comments/{commentId} {
      allow read: if true;
      allow create: if safeCommentCreate();
      // Admin moderates; users can delete their own (client checks ownership
      // via stored userId before deleting — Firestore can't verify because
      // the doc's userId is the device-generated id, not the Firebase Auth uid).
      allow delete: if signedIn() || adminWrite();
      // Updates: admin moderation OR client incrementing `reportCount` only.
      allow update: if adminWrite() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'replyCount'])
      );
    }

    match /{path=**}/comments/{commentId} {
      allow read: if isAdmin();
    }

    match /storyInteractions/{storyId}/comments/{commentId}/reports/{userId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.size() <= 5;
      allow delete: if signedIn() || adminWrite();
      allow update: if false;
    }

    match /storyInteractions/{storyId}/comments/{commentId}/replies/{replyId} {
      allow read: if true;
      allow create: if safeCommentCreate();
      allow delete: if signedIn() || adminWrite();
      allow update: if adminWrite() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
      );
    }

    match /{path=**}/replies/{replyId} {
      allow read: if isAdmin();
    }

    match /storyInteractions/{storyId}/comments/{commentId}/replies/{replyId}/reports/{userId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.size() <= 5;
      allow delete: if signedIn() || adminWrite();
      allow update: if false;
    }

    match /userBans/{userId} {
      allow read: if signedIn();
      allow write: if adminWrite();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
