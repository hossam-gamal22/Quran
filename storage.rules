rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all files (app downloads sounds, images, etc.)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Sound uploads — admin only (requires Firebase Auth)
    match /sounds/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // Pending sounds for next build — admin only
    match /pending-sounds/{category}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // App content images (icons, backgrounds) — admin panel writes
    // (no Firebase Auth on admin; same trust model as Firestore admin
    // collections — open write, will be locked down via Netlify proxy
    // in Phase B0.5).
    match /appContent/{fileName} {
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // General admin uploads (welcome banner backgrounds, etc.)
    match /uploads/{allPaths=**} {
      allow write: if request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('audio/.*'));
      allow delete: if true;
    }

    // Adhkar audio files uploaded from AzkarManager admin page.
    // Same trust model as other admin uploads.
    match /adhkar-audio/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
      allow delete: if true;
    }

    // Admin-managed image uploads used by the dashboard editors.
    match /category-icons/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    match /theme-icons/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    match /backgrounds/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    match /content-icons/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    match /content-videos/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
      allow delete: if true;
    }

    match /app-content/icons/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    // Admin-managed audio/PDF uploads.
    match /duas-audio/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
      allow delete: if true;
    }

    match /pdf-uploads/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
      allow delete: if true;
    }

    match /theme-pdfs/{fileName} {
      allow write: if request.resource != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
      allow delete: if true;
    }

    // User cloud backups — per-user JSON blobs keyed by OAuth openId.
    // Users can only read/write their own backup files.
    match /userBackups/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
