rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all files (app downloads sounds, images, etc.)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Sound uploads — admin only (requires Firebase Auth)
    match /sounds/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // Pending sounds for next build — admin only
    match /pending-sounds/{category}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }

    // App content images (icons, backgrounds) — admin only
    match /appContent/{fileName} {
      allow write: if request.auth != null;
    }

    // General admin uploads
    match /uploads/{allPaths=**} {
      allow write: if request.auth != null;
    }

    // User cloud backups — per-user JSON blobs keyed by OAuth openId.
    // App-level validation ensures openId matches the logged-in user.
    match /userBackups/{userId}/{allPaths=**} {
      allow read, write: if true;
    }
  }
}
