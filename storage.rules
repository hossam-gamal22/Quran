rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    function validAudio(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('audio/.*');
    }

    function validVideo(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('video/.*');
    }

    function validPdf(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType == 'application/pdf';
    }

    // Public reads are granted only on known asset paths below. User backups
    // must never inherit a global public read rule.
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    match /sounds/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validAudio(10 * 1024 * 1024);
    }

    match /pending-sounds/{category}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validAudio(10 * 1024 * 1024);
    }

    match /appContent/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validImage(10 * 1024 * 1024);
    }

    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
        );
      allow delete: if isAdmin();
    }

    match /adhkar-audio/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validAudio(15 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /category-icons/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validImage(2 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /theme-icons/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validImage(5 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /backgrounds/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validImage(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /content-icons/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validImage(5 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /content-videos/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validVideo(200 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /app-content/icons/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validImage(5 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /duas-audio/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validAudio(15 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /pdf-uploads/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validPdf(25 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /theme-pdfs/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validPdf(25 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /userBackups/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/json'
        && request.resource.metadata.openId == userId;
      allow delete: if signedIn();
    }
  }
}
