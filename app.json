{
  "expo": {
    "name": "روح المسلم",
    "slug": "rooh-almuslim",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/images/icons/icon.png",
    "scheme": "rooh-almuslim",
    "jsEngine": "hermes",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/fonts/qcf/**",
      "assets/fonts/**",
      "assets/images/**",
      "assets/sounds/**",
      "assets/stories/**",
      "assets/design/**",
      "assets/translations/**",
      "assets/lottie/**"
    ],
    "splash": {
      "image": "./assets/images/icons/App-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rooh.almuslim",
      "buildNumber": "7",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.rooh.almuslim"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "GADApplicationIdentifier": "ca-app-pub-3645278220050673~7902167287",
        "NSSupportsLiveActivities": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsArbitraryLoadsForMedia": true,
          "NSExceptionDomains": {
            "api.aladhan.com": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": false
            }
          }
        },
        "NSLocationWhenInUseUsageDescription": "يُستخدم موقعك لحساب أوقات الصلاة واتجاه القبلة بدقة",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ],
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "cstr6suwn9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "4fzdc2evr5.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "2fnua5tdw4.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "ydx93a7ass.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "5a6flpkh64.skadnetwork"
          }
        ],
        "NSUserTrackingUsageDescription": "يستخدم هذا التطبيق معرف الإعلانات لعرض إعلانات مخصصة",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons/android-icon-foreground.png",
        "backgroundImage": "./assets/images/icons/android-icon-background.png",
        "monochromeImage": "./assets/images/icons/android-icon-monochrome.png"
      },
      "package": "com.rooh.almuslim",
      "versionCode": 15,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "rooh-almuslim"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-tracking-transparency",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icons/notification-icon.png",
          "color": "#22c55e",
          "androidMode": "default",
          "androidCollapsedTitle": "روح المسلم",
          "sounds": [
            "./assets/sounds/general_reminder.mp3",
            "./assets/sounds/salawat.mp3",
            "./assets/sounds/istighfar.mp3",
            "./assets/sounds/tasbih.mp3",
            "./assets/sounds/subhanallah.mp3",
            "./assets/sounds/alhamdulillah.mp3",
            "./assets/sounds/morning_adhkar.mp3",
            "./assets/sounds/evening_adhkar.mp3",
            "./assets/sounds/makkah.mp3",
            "./assets/sounds/madinah.mp3",
            "./assets/sounds/alaqsa.mp3",
            "./assets/sounds/mishary.mp3",
            "./assets/sounds/abdulbasit.mp3",
            "./assets/sounds/sudais.mp3",
            "./assets/sounds/egypt.mp3",
            "./assets/sounds/dosari.mp3",
            "./assets/sounds/ajman.mp3",
            "./assets/sounds/ali_mulla.mp3",
            "./assets/sounds/naqshbandi.mp3",
            "./assets/sounds/sharif.mp3",
            "./assets/sounds/mansoor_zahrani.mp3",
            "./assets/sounds/haramain.mp3",
            "./assets/sounds/silent.mp3",
            "./assets/sounds/notif_sleep.mp3",
            "./assets/sounds/notif_wakeup.mp3",
            "./assets/sounds/notif_after_prayer.mp3",
            "./assets/sounds/notif_verse.mp3",
            "./assets/sounds/notif_kahf.mp3",
            "./assets/sounds/notif_daily_summary.mp3"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "نحتاج الموقع لتحديد اتجاه القبلة وأوقات الصلاة"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "نحتاج إذن الحركة لتحديد اتجاه القبلة"
        }
      ],
      "expo-asset",
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3645278220050673~7902167287",
          "iosAppId": "ca-app-pub-3645278220050673~7902167287"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Amiri-Regular.ttf",
            "./assets/fonts/Amiri-Bold.ttf"
          ],
          "widgets": [
            {
              "name": "PrayerTimesSmall",
              "label": "الصلاة القادمة",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "عرض الصلاة القادمة والعد التنازلي",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/icons/icon.png"
            },
            {
              "name": "PrayerTimesMedium",
              "label": "مواقيت الصلاة",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "عرض جميع مواقيت الصلاة",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/icons/icon.png"
            },
            {
              "name": "DailyVerseSmall",
              "label": "آية اليوم",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "آية من القرآن الكريم يوميًا",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/icons/icon.png"
            },
            {
              "name": "DailyVerseMedium",
              "label": "آية اليوم",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "آية من القرآن الكريم مع اسم السورة",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/icons/icon.png"
            },
            {
              "name": "DailyDhikrSmall",
              "label": "ذكر اليوم",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "ذكر يومي للتذكير",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/icons/icon.png"
            },
            {
              "name": "DailyDhikrMedium",
              "label": "ذكر اليوم",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "ذكر اليوم مع المصدر",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/icons/icon.png"
            },
            {
              "name": "AzkarProgressSmall",
              "label": "الأذكار اليومية",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "تتبع أذكار الصباح والمساء",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/icons/icon.png"
            },
            {
              "name": "AzkarProgressMedium",
              "label": "الأذكار اليومية",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "تقدم أذكار الصباح والمساء",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/icons/icon.png"
            },
            {
              "name": "HijriDateSmall",
              "label": "التاريخ الهجري",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "عرض التاريخ الهجري",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/icons/icon.png"
            },
            {
              "name": "HijriDateMedium",
              "label": "التاريخ الهجري",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "التاريخ الهجري والميلادي",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/images/icons/icon.png"
            }
          ]
        }
      ],
      "./plugins/with-alarm-clock-scheduling",
      "./plugins/with-ios-widgets",
      "./plugins/with-live-activities",
      "./plugins/with-android-gradle-fix",
      [
        "./plugins/with-notification-large-icon",
        {
          "icon": "./assets/images/icons/icon.png"
        }
      ],
      [
        "expo-dynamic-app-icon",
        {
          "app_icon_english": {
            "image": "./assets/images/icons/icon_en.png",
            "prerendered": true
          },
          "ramadan": {
            "image": "./assets/images/icons/seasonal/ramadan.png",
            "prerendered": true
          },
          "hajj": {
            "image": "./assets/images/icons/seasonal/hajj.png",
            "prerendered": true
          },
          "mawlid": {
            "image": "./assets/images/icons/seasonal/mawlid.png",
            "prerendered": true
          },
          "eid_fitr": {
            "image": "./assets/images/icons/seasonal/eid_fitr.png",
            "prerendered": true
          },
          "eid_adha": {
            "image": "./assets/images/icons/seasonal/eid_adha.png",
            "prerendered": true
          },
          "dhul_hijjah": {
            "image": "./assets/images/icons/seasonal/dhul_hijjah.png",
            "prerendered": true
          }
        }
      ],
      "./modules/proximity-sensor/plugin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "12ffec15-6357-43b4-a309-8e71cc2afc8c",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "RoohAlMuslimWidgets",
                  "bundleIdentifier": "com.rooh.almuslim.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.rooh.almuslim"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "hossamgamal",
    "runtimeVersion": "1.2.0",
    "updates": {
      "url": "https://u.expo.dev/12ffec15-6357-43b4-a309-8e71cc2afc8c",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    }
  }
}
